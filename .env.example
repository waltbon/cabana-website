WORDPRESS_URL="https://wordpress.com"
WORDPRESS_HOSTNAME="wordpress.com"

# If using the revalidate plugin
# You can generate by running `openssl rand -base64 32` in the terminal
WORDPRESS_WEBHOOK_SECRET="your-secret-key-here"

# ClickUp API integration for contact form
# Get your API key from: https://app.clickup.com/settings/apps
CLICKUP_API_KEY="pk_your_clickup_api_key"
# Get your List ID from ClickUp (the list where leads will be created)
CLICKUP_LIST_ID="your_list_id"
